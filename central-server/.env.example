# ---- Copy this file to .env (local) or paste the values into your host's Environment settings ----
NODE_ENV=production
PORT=8787

# Run `npm run keys` to generate these three
SERVER_SECRET=
ADMIN_TOKEN=
VAPID_PUBLIC=
VAPID_PRIVATE=

# Gmail SMTP (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional: shown as sender address (Gmail only allows your own address)
MAIL_FROM=yourname@gmail.com

# Set to 1 when the server runs behind a host proxy (Render, Railway, Fly, Koyeb ...)
TRUST_PROXY=1

# Where the SQLite file lives (mount a persistent disk here if your host has one)
# DB_PATH=/var/data/server.db
